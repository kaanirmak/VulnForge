# Generate both secrets independently: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=replace_with_random_value
ADMIN_TOKEN=replace_with_another_random_value
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./private-key.pem
DATABASE_PATH=./data/vulnforge.db
ENABLE_AUTO_PR=false
# Optional CISA known-exploited CVE prioritization. Requires CISA feed reachability.
ENABLE_KEV=false
SCAN_INTERVAL_SECONDS=3600
GITHUB_API_URL=https://api.github.com
OSV_API_URL=https://api.osv.dev
