# Generate both secrets independently: python -c "import secrets; print(secrets.token_hex(32))"
WEBHOOK_SECRET=replace_with_random_value
ADMIN_TOKEN=replace_with_another_random_value
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./private-key.pem
DATABASE_PATH=./data/vulnforge.db
# Optional PostgreSQL URI takes precedence over DATABASE_PATH. Keep actual credentials private.
# Install locally with: pip install -e '.[dev,postgres]'
DATABASE_URL=
# Apply migrations separately with the migration account; false only verifies schema.
DATABASE_AUTO_MIGRATE=true
# Separate non-owner, NOBYPASSRLS customer login. Required for PostgreSQL preview.
CUSTOMER_DATABASE_URL=
ENABLE_AUTO_PR=false
# Optional CISA known-exploited CVE prioritization. Requires CISA feed reachability.
ENABLE_KEV=false
SCAN_INTERVAL_SECONDS=900
GITHUB_API_URL=https://api.github.com
OSV_API_URL=https://api.osv.dev

# Requires GitHub App Checks: write. Incomplete scans report action_required.
ENABLE_CHECKS=false

# Privacy defaults: no server source access and no package metadata sent to OSV.
SCAN_MODE=customer_runner
ALLOW_MANAGED_SOURCE_ACCESS=false
MANAGED_SCAN_CONSENT_ID=
INTELLIGENCE_MODE=disabled
ALLOW_EXTERNAL_PACKAGE_METADATA=false
# Exact ecosystem:name approvals; no wildcard approvals. Private denials win.
OSV_ALLOWED_PACKAGES=
PRIVATE_PACKAGE_PATTERNS=
# Separate operator-only intake; reports remain quarantined, never trusted scans.
OPERATOR_REPORT_TOKEN=

# Login-only GitHub App OAuth. These are distinct from App ID/private key.
# All three must be set together; otherwise keep all blank. No customer API access yet.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
PUBLIC_ORIGIN=
# HTTP allowed only for loopback development, using separate local cookie names.
ALLOW_INSECURE_LOCAL_AUTH=false
# Local loopback preview only. Production tenant/API/worker isolation is unfinished.
CUSTOMER_API_PREVIEW=false

# Named operator-only access. Do not put these keys in the customer workflow.
# JSON object of operator ID -> independent 32+ character random token.
# Leave ADMIN_TOKEN empty when this is configured. Rotate by replacing/removing
# a named key and restarting API instances; values are omitted from audit logs.
OPERATOR_CREDENTIALS={}

# Experimental OIDC report intake: loopback customer preview only, always quarantined.
# Requires CUSTOMER_API_PREVIEW plus an approved immutable reusable workflow ref.
# Leave off until App metadata credentials and the reviewed workflow are available.
RUNNER_OIDC_PREVIEW=false
RUNNER_TRUSTED_WORKFLOWS=

# Source-free project onboarding preview. Requires loopback CUSTOMER_API_PREVIEW.
# Uses the same App OAuth client and the additional /auth/github/connect/callback.
GITHUB_CONNECTION_PREVIEW=false
